# Copie este arquivo para ".env" (na raiz do projeto) e troque os valores.
# O arquivo .env NUNCA deve ser versionado (já está no .gitignore).

# ---------- Banco de dados ----------
POSTGRES_DB=avaliacoes
POSTGRES_USER=avaliacoes
POSTGRES_PASSWORD=troque_esta_senha

DATABASE_URL=postgresql://avaliacoes:troque_esta_senha@localhost:5432/avaliacoes

# Banco EXCLUSIVO dos testes automatizados (obrigatório para `npm test`).
# Precisa apontar para um banco DIFERENTE de DATABASE_URL: os testes apagam os
# dados a cada execução. O script de testes cria o banco sozinho se ele não existir
# (exige que o usuário do banco tenha o atributo CREATEDB).
DATABASE_URL_TESTE=postgresql://avaliacoes:troque_esta_senha@localhost:5432/avaliacoes_teste

# ---------- API ----------
NODE_ENV=development
PORT=3000

# ---------- Cache de leitura em Redis (Projeto N2) ----------
#
# O sistema FUNCIONA SEM REDIS. Sem servidor no ar, a API lê tudo do PostgreSQL e apenas
# avisa uma vez no log; nenhuma tela muda de comportamento. Subir o servidor:
#
#   docker run -d --name redis -p 6379:6379 redis:7
#
# CACHE_ATIVO desliga a camada sem precisar derrubar o Redis — útil para medir o "antes" e
# o "depois" com o mesmo comando (`npm --prefix backend run medir`). Padrão: ligado fora
# dos testes, desligado nos testes (uma suíte não pode depender de servidor externo).
CACHE_ATIVO=true
REDIS_URL=redis://localhost:6379

# Redis EXCLUSIVO dos testes, no banco lógico 9 — mesma disciplina do DATABASE_URL_TESTE.
# Sem ele, os casos de HIT/MISS se declaram "skip" e o resto da suíte roda igual.
REDIS_URL_TESTE=redis://localhost:6379/9

# Validade da estrutura da prova no cache. A prova congelada é imutável, então este TTL
# não existe para evitar dado velho: existe para a chave não ocupar memória para sempre.
CACHE_TTL_ESTRUTURA_SEGUNDOS=21600
# Espera pela conexão (ms). Curta de propósito: a consulta que o cache evita custa ~2,5 ms.
CACHE_ESPERA_CONEXAO_MS=1000
# Depois de uma falha, nem tenta o Redis por este tempo (ms). Sem a pausa, com o Redis
# fora do ar toda requisição pagaria a espera acima e o atalho viraria imposto.
CACHE_ESPERA_APOS_FALHA_MS=30000

# ---------- Autenticação (Etapa 1) ----------
# Obrigatório: assina os JWT da sessão. Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=gere_um_valor_longo_e_aleatorio
# Base dos links enviados por e-mail (recuperação de senha).
FRONTEND_URL=http://localhost:5173

# ---------- E-mail (Etapa 1) ----------
# Opcional em desenvolvimento: sem SMTP_HOST, o link de redefinição é impresso
# no log da API em vez de enviado por e-mail (DT11, P-11).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sistema de Avaliacoes <nao-responda@exemplo.com>

# ---------- Administrador inicial (criado pelo seed apenas se não existir) ----------
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque_esta_senha_do_admin

# ---------- Correção assistida por Inteligência Artificial (RF11) ----------
#
# O sistema FUNCIONA SEM ESTAS VARIÁVEIS. Sem provedor ou sem chave, a sugestão de nota é
# gerada em modo simulado: o fluxo inteiro funciona e a própria justificativa avisa, com
# todas as letras, que a sugestão é fictícia. É assim que se desenvolve e se demonstra o
# recurso antes de ter uma chave.
#
# Para usar um serviço de verdade, preencha as três variáveis abaixo.
#
# IA_PROVEDOR aceita: openai | gemini | anthropic | simulado
#
#   openai     -> GPT, da OpenAI.      Chave em https://platform.openai.com/api-keys
#   gemini     -> Gemini, do Google.   Chave em https://aistudio.google.com/apikey
#   anthropic  -> Claude, da Anthropic. Chave em https://console.anthropic.com/
#
# IA_MODELO é opcional: sem ele, cada provedor usa o modelo padrão indicado abaixo.
# CONFIRA na sua conta quais modelos estão disponíveis — os nomes mudam com o tempo.
#
#   openai     -> gpt-4o-mini
#   gemini     -> gemini-flash-lite-latest
#   anthropic  -> claude-sonnet-5
#
# Prefira nomes terminados em "-latest" quando o provedor os oferecer: nomes com número
# de versão são descontinuados com o tempo e passam a responder 404. Se isso acontecer,
# consulte a lista de modelos da sua conta e troque este valor. Atenção: um modelo já
# descontinuado pode continuar aparecendo nessa lista e, ainda assim, recusar a chamada
# com "no longer available to new users" — o log do servidor mostra essa mensagem.
#
# ATENÇÃO: a chave é uma credencial. Ela fica somente neste arquivo (.env), que NUNCA é
# versionado. Não a cole em código, em teste, em captura de tela nem no documento do TFC.
# Se ela vazar, revogue no painel do provedor e gere outra.

IA_PROVEDOR=simulado
IA_MODELO=
IA_API_KEY=

# Tempo máximo de espera pela resposta do serviço, em milissegundos. Passado esse limite,
# o sistema avisa que a sugestão não veio e o professor corrige manualmente (UC11 A5).
IA_TIMEOUT_MS=25000
