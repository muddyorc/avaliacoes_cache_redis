{
  "name": "avaliacoes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do Sistema Web de Gerenciamento e Auxílio à Correção de Avaliações Digitais e Monitoramento Anticola",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node scripts/testar.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node --test --import ./tests/ajuda/sem-rede.js \"tests/unitarios/*.test.js\"",
    "estresse": "node scripts/estresse.js",
    "medir": "node scripts/medir.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.2.2"
  }
}
